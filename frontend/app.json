{
  "expo": {
    "name": "Cycle Buddy",
    "slug": "cycle-buddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cyclebuddy.app",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Cycle Buddy needs calendar access to set reminders"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.cyclebuddy.app"
    },
    "plugins": [
      "expo-notifications",
      "expo-secure-store"
    ],
    "extra": {
      "apiUrl": "https://cycle-buddy-production.up.railway.app/api"
    }
  }
}
